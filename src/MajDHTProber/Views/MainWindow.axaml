<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MajDHTProber.ViewModels"
        xmlns:v="using:MajDHTProber.Views"
        xmlns:c="using:MajDHTProber.Controls"
        xmlns:conv="using:MajDHTProber.Converters"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="860"
        x:Class="MajDHTProber.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MajDHT Prober"
        Width="1380" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:OverviewViewModel">
            <v:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="vm:PeersViewModel">
            <v:PeersView />
        </DataTemplate>
        <DataTemplate DataType="vm:ContentViewModel">
            <v:ContentView />
        </DataTemplate>
        <DataTemplate DataType="vm:ToolsViewModel">
            <v:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="vm:LogsViewModel">
            <v:LogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <v:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="236,*">
        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11" Margin="6,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <c:LineIcon Data="{StaticResource Icon.Logo}" Foreground="White" Width="22" Height="22" StrokeThickness="1.7" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="MajDHT Prober" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="DHT 网络探测器" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <TextBlock Classes="label" Text="当前操作节点" Margin="4,0,0,0" />
                    <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding ActiveSession}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Classes.success="{Binding IsSuccess}" Classes.info="{Binding IsInfo}" Classes.danger="{Binding IsDanger}" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ContentControl Content="{Binding ActiveSession}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:SessionItemViewModel">
                                <Border Classes="subtle" Padding="10,8">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Classes="dot" Classes.success="{Binding IsSuccess}" Classes.info="{Binding IsInfo}"
                                                     Classes.danger="{Binding IsDanger}" />
                                            <TextBlock Text="{Binding StateText}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Classes="mono" FontSize="11.5" Text="{Binding ShortNodeId}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock FontSize="11.5" Text="{Binding DetailText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="ghost" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                ToolTip.Tip="打开日志">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:LineIcon Classes="small" Data="{StaticResource Icon.Warning}"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ProblemsText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="iconbutton" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="切换浅色 / 深色主题">
                            <c:LineIcon Data="{StaticResource Icon.Moon}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <c:LineIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Grid Margin="30,22,30,14" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h1" Text="{Binding SelectedPage.Title}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding SelectedPage.Description}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="pill info" IsVisible="{Binding IsGeneratingIdentity}" VerticalAlignment="Center" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressBar IsIndeterminate="True" Width="56" MinWidth="56" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IdentityGenerationText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl Grid.Row="1" Margin="30,0,30,0" Content="{Binding SelectedPage.Page}" />

            <!-- Transient notification -->
            <Border Grid.Row="1" Classes="toast" IsVisible="{Binding Notifications.IsVisible}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Classes="dot" Classes.success="{Binding Notifications.IsSuccess}" Classes.info="{Binding Notifications.IsInfo}"
                             Classes.warning="{Binding Notifications.IsWarning}" Classes.danger="{Binding Notifications.IsDanger}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Notifications.Message}" />
                    <Button Grid.Column="2" Classes="iconbutton" Margin="10,0,0,0" Padding="3" Command="{Binding Notifications.DismissCommand}"
                            Foreground="{DynamicResource ToastForegroundBrush}">
                        <c:LineIcon Classes="small" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="30,7">
                <TextBlock Text="{Binding StatusBarText}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
