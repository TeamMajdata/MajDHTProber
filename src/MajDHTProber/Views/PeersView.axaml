<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajDHTProber.ViewModels"
             xmlns:c="using:MajDHTProber.Controls"
             x:Class="MajDHTProber.Views.PeersView"
             x:DataType="vm:PeersViewModel">
    <Grid ColumnDefinitions="*,16,480" Margin="0,0,0,16">
        <!-- Peer list -->
        <Border Classes="card" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding SearchText}" PlaceholderText="按节点 ID、标签、地址、能力或来源搜索…">
                        <TextBox.InnerLeftContent>
                            <c:LineIcon Classes="small" Data="{StaticResource Icon.Search}" Margin="10,0,0,0"
                                        Foreground="{DynamicResource TextTertiaryBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding ToggleAddFormCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:LineIcon Data="{StaticResource Icon.Plus}" />
                                <TextBlock Text="添加节点" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleScanFormCommand}" ToolTip.Tip="向局域网广播签名 Hello，列出应答的节点">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:LineIcon Data="{StaticResource Icon.Radar}" />
                                <TextBlock Text="扫描局域网" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshNeighborsCommand}" ToolTip.Tip="以自身 ID 查找邻居，发现更多节点">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:LineIcon Data="{StaticResource Icon.Refresh}" />
                                <TextBlock Text="发现节点" />
                            </StackPanel>
                        </Button>
                        <Button Classes="iconbutton" Command="{Binding ClearInactiveCommand}" ToolTip.Tip="清除已断开和已过期的节点">
                            <c:LineIcon Data="{StaticResource Icon.Trash}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Add form -->
                <Border Grid.Row="1" Classes="subtle" Margin="0,12,0,0" Padding="14,12" IsVisible="{Binding IsAddFormOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h3" Text="手动添加节点" />
                        <TextBlock Classes="caption"
                                   Text="当前节点直接向该端点发送签名 Hello（先用所选传输，无应答时在同一端口改用另一种），把应答节点按观察到的端点加入路由表并经它查找邻居；若它具备 Traversal 或 Forwarder 能力且本节点已启用 NAT 穿透，则同时向它登记。支持 IP:端口、[IPv6]:端口 和 主机名:端口。" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Classes="mono" Text="{Binding AddEndpointText}" PlaceholderText="例如 192.168.1.20:42000" />
                            <ComboBox Grid.Column="1" Width="120" ItemsSource="{Binding TransportOptions}" SelectedIndex="{Binding AddTransportIndex}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Classes="accent" Command="{Binding AddPeerCommand}" Content="添加" />
                                <Button Command="{Binding AddPeerCancelCommand}" Content="取消" IsVisible="{Binding AddPeerCommand.IsRunning}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding AddPeerCommand.IsRunning}" />
                        <ContentControl Content="{Binding AddResult}" />
                    </StackPanel>
                </Border>

                <!-- LAN scan panel -->
                <Border Grid.Row="2" Classes="subtle" Margin="0,12,0,0" Padding="14,12" IsVisible="{Binding IsScanFormOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h3" Text="扫描局域网" />
                        <TextBlock Classes="caption"
                                   Text="以探针身份向本机每个 IPv4 子网的广播地址发送一次签名 Hello；所有在该 UDP 端口监听的节点都会应答，应答经签名校验后列出。扫描结果只是线索，“添加”仍由当前节点自己发送 Hello 并校验身份。监听其他端口的节点不会被发现。" />
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="label" Text="UDP 端口" VerticalAlignment="Center" Margin="0" />
                            <NumericUpDown Grid.Column="1" Value="{Binding ScanPort}" Minimum="1" Maximum="65535" FormatString="0" Width="130" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                <Button Classes="accent" Command="{Binding ScanLanCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <c:LineIcon Data="{StaticResource Icon.Radar}" />
                                        <TextBlock Text="扫描" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ScanLanCancelCommand}" Content="取消" IsVisible="{Binding ScanLanCommand.IsRunning}" />
                                <Button Command="{Binding AddAllDiscoveredCommand}" Content="全部添加" IsVisible="{Binding !!DiscoveredPeers.Count}" />
                                <Button Command="{Binding AddAllDiscoveredCancelCommand}" Content="停止" IsVisible="{Binding AddAllDiscoveredCommand.IsRunning}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding ScanLanCommand.IsRunning}" />
                        <ContentControl Content="{Binding ScanResult}" />
                        <ItemsControl ItemsSource="{Binding DiscoveredPeers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoveredPeerViewModel">
                                    <Grid ColumnDefinitions="1.3*,1.4*,1.1*,0.9*,1.4*,Auto" ColumnSpacing="8" Margin="0,3">
                                        <TextBlock Classes="cell mono" FontWeight="SemiBold" Text="{Binding ShortId}" ToolTip.Tip="{Binding NodeId}" />
                                        <TextBlock Grid.Column="1" Classes="cell mono" Text="{Binding EndpointText}" />
                                        <TextBlock Grid.Column="2" Classes="cell" Text="{Binding CapabilitiesText}" />
                                        <TextBlock Grid.Column="3" Classes="cell mono" Text="{Binding RoundTripText}" />
                                        <TextBlock Grid.Column="4" Classes="caption" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding StatusText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Padding="9,4" Content="添加" IsEnabled="{Binding CanAdd}"
                                                Command="{Binding $parent[ItemsControl].((vm:PeersViewModel)DataContext).AddDiscoveredCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="3" Classes="chips" Margin="0,12,0,10" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PeerFilterOption">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                <TextBlock Text="{Binding Count}" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" Classes="tablehead">
                    <Grid ColumnDefinitions="1.7*,0.9*,1.8*,1.1*,0.7*,0.9*">
                        <TextBlock Classes="head" Text="节点" />
                        <TextBlock Grid.Column="1" Classes="head" Text="状态" />
                        <TextBlock Grid.Column="2" Classes="head" Text="地址" />
                        <TextBlock Grid.Column="3" Classes="head" Text="能力" />
                        <TextBlock Grid.Column="4" Classes="head" Text="丢包" />
                        <TextBlock Grid.Column="5" Classes="head" Text="最近活动" />
                    </Grid>
                </Border>

                <Panel Grid.Row="5">
                    <ListBox Classes="rows" ItemsSource="{Binding VisiblePeers}" SelectedItem="{Binding SelectedPeer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PeerItemViewModel">
                                <Grid ColumnDefinitions="1.7*,0.9*,1.8*,1.1*,0.7*,0.9*">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                                        <TextBlock Classes="cell mono" FontWeight="SemiBold" Text="{Binding Title}" ToolTip.Tip="{Binding NodeId}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Classes="pill accent" Padding="6,0,6,1" IsVisible="{Binding IsManual}">
                                                <TextBlock Text="手动" FontSize="10.5" />
                                            </Border>
                                            <Border Classes="pill info" Padding="6,0,6,1" IsVisible="{Binding IsLocalNode}">
                                                <TextBlock Text="本地" FontSize="10.5" />
                                            </Border>
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding SourcesText}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Ellipse Classes="dot" Classes.success="{Binding IsSuccess}" Classes.info="{Binding IsInfo}"
                                                 Classes.warning="{Binding IsWarning}" Classes.danger="{Binding IsDanger}" />
                                        <TextBlock Classes="cell" Text="{Binding StateText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="cell mono" Text="{Binding AddressText}" ToolTip.Tip="{Binding ReachabilityText}" />
                                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding CapabilitiesText}" />
                                    <TextBlock Grid.Column="4" Classes="cell mono" Text="{Binding LossText}" />
                                    <TextBlock Grid.Column="5" Classes="cell" Text="{Binding LastSeenText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                        <Border Classes="iconbadge" Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center">
                            <c:LineIcon Data="{StaticResource Icon.Nodes}" Width="24" Height="24" />
                        </Border>
                        <TextBlock Classes="h3" Text="还没有发现任何节点" HorizontalAlignment="Center" />
                        <TextBlock Classes="caption" TextAlignment="Center"
                                   Text="启动节点后，可在设置中配置引导端点并点击“引导”，使用“扫描局域网”发现同一网络内的节点，或使用“添加节点”手动输入端点；也可以在概览页创建本地测试节点。" />
                    </StackPanel>
                </Panel>
            </Grid>
        </Border>

        <!-- Detail panel -->
        <Border Grid.Column="2" Classes="card" Padding="0">
            <Panel>
                <StackPanel IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="10" Margin="24">
                    <Border Classes="iconbadge" Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center">
                        <c:LineIcon Data="{StaticResource Icon.Search}" Width="24" Height="24" />
                    </Border>
                    <TextBlock Classes="h3" Text="选择一个节点" HorizontalAlignment="Center" />
                    <TextBlock Classes="caption" TextAlignment="Center" Text="在左侧列表中选择节点，查看连接状态、观察到的端点、传输统计，并进行探测、路由探测与打洞。" />
                </StackPanel>
                <ScrollViewer IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Detail}" Margin="18">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:PeerDetailViewModel">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Classes="h2" Text="{Binding Item.Title}" />
                                            <Border Classes="pill" Classes.success="{Binding Item.IsSuccess}" Classes.info="{Binding Item.IsInfo}"
                                                    Classes.warning="{Binding Item.IsWarning}" Classes.danger="{Binding Item.IsDanger}">
                                                <TextBlock Text="{Binding Item.StateText}" />
                                            </Border>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Classes="mono muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Item.NodeId}" />
                                            <Button Grid.Column="1" Classes="iconbutton" Padding="4" VerticalAlignment="Top" Command="{Binding CopyNodeIdCommand}"
                                                    ToolTip.Tip="复制节点 ID">
                                                <c:LineIcon Classes="small" Data="{StaticResource Icon.Copy}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Classes="caption" Text="{Binding StateDescription}" />
                                    </StackPanel>

                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="accent" Command="{Binding ProbeCommand}" ToolTip.Tip="以独立探针身份对每个观察到的端点分别做 TCP / UDP 签名 Hello + 加密 Ping">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:LineIcon Data="{StaticResource Icon.Radar}" />
                                                <TextBlock Text="探测端点" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CheckRouteCommand}" ToolTip.Tip="经本节点自己的路由（含打洞与 Forwarder 回退）查找该节点 ID">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:LineIcon Data="{StaticResource Icon.Globe}" />
                                                <TextBlock Text="路由探测" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RegisterTraversalCommand}" IsVisible="{Binding Item.IsTraversal}" ToolTip.Tip="在该 Traversal 节点登记本节点被观察到的端点，用于打洞与可达性回拨">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:LineIcon Data="{StaticResource Icon.Relay}" />
                                                <TextBlock Text="登记 Traversal" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RegisterForwarderCommand}" IsVisible="{Binding Item.IsForwarder}" ToolTip.Tip="与该 Forwarder 建立转发会话，使其他节点能经它联系本节点">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:LineIcon Data="{StaticResource Icon.Relay}" />
                                                <TextBlock Text="建立转发会话" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CopyEndpointCommand}" IsVisible="{Binding !HasNoEndpoints}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:LineIcon Data="{StaticResource Icon.Copy}" />
                                                <TextBlock Text="复制端点" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="danger" Command="{Binding ForgetCommand}" ToolTip.Tip="仅从列表移除">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:LineIcon Data="{StaticResource Icon.Trash}" />
                                                <TextBlock Text="移除" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="danger" Command="{Binding EvictCommand}" Content="移出路由表" ToolTip.Tip="同时从本节点路由表移除" />
                                    </WrapPanel>
                                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                                    <ContentControl Content="{Binding ActionResult}" />

                                    <Border Classes="subtle" Padding="14,12">
                                        <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Classes="field" Text="能力" />
                                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Item.CapabilitiesText}" />
                                            <TextBlock Grid.Row="1" Classes="field" Text="可达性" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Item.ReachabilityText}" />
                                            <TextBlock Grid.Row="2" Classes="field" Text="路由表" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding RoutingText}" />
                                            <TextBlock Grid.Row="3" Classes="field" Text="NAT 映射" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding MappingText}" />
                                            <TextBlock Grid.Row="4" Classes="field" Text="身份工作量" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding IdentityWorkText}" />
                                            <TextBlock Grid.Row="5" Classes="field" Text="联系人" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding LeaseText}" />
                                            <TextBlock Grid.Row="6" Classes="field" Text="来源" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding Item.SourcesText}" />
                                            <TextBlock Grid.Row="7" Classes="field" Text="首次发现" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Classes="value" Text="{Binding FirstSeenText}" />
                                            <TextBlock Grid.Row="8" Classes="field" Text="最后交互" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" Classes="value" Text="{Binding LastInteractionText}" />
                                            <TextBlock Grid.Row="9" Classes="field" Text="最后失败" />
                                            <TextBlock Grid.Row="9" Grid.Column="1" Classes="value" Text="{Binding LastFailureText}" />
                                            <TextBlock Grid.Row="10" Classes="field" Text="本节点观察" ToolTip.Tip="本节点自己最近一次与它交换已认证数据包的端点" />
                                            <TextBlock Grid.Row="10" Grid.Column="1" Classes="value mono" Text="{Binding ObservedEndpointText}" />
                                            <TextBlock Grid.Row="11" Classes="field" Text="最近探测" />
                                            <TextBlock Grid.Row="11" Grid.Column="1" Classes="value" Text="{Binding LastProbeText}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="h3" Text="观察到的端点" />
                                        <TextBlock Classes="caption" Text="本节点或引荐它的节点从实际数据包中观察到的端点；联系人本身不携带端点。" />
                                        <TextBlock Classes="caption" IsVisible="{Binding HasNoEndpoints}"
                                                   Text="尚未观察到端点：该节点为私有节点，或只经 Forwarder 应答过，只能经它提示的 Forwarder 访问。" />
                                        <ItemsControl ItemsSource="{Binding Endpoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EndpointRowViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                        <TextBlock Classes="cell mono" Text="{Binding AddressText}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="cell mono" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding TcpText, StringFormat='TCP {0}'}" />
                                                            <TextBlock Classes="cell mono" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding UdpText, StringFormat='UDP {0}'}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Spacing="4" IsVisible="{Binding !!Hints.Count}">
                                            <TextBlock Classes="label" Text="提示的 Traversal 节点与 Forwarder" />
                                            <ItemsControl ItemsSource="{Binding Hints}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <SelectableTextBlock Classes="mono muted" FontSize="12" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="8" IsVisible="{Binding !!ProbeResults.Count}">
                                        <TextBlock Classes="h3" Text="端点探测结果" />
                                        <ItemsControl ItemsSource="{Binding ProbeResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProbeRowViewModel">
                                                    <Border Classes="subtle" Margin="0,0,0,6" Padding="10,7">
                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Ellipse Classes="dot" Classes.success="{Binding IsSuccess}" Classes.warning="{Binding IsWarning}"
                                                                         Classes.danger="{Binding IsDanger}" />
                                                                <TextBlock Classes="cell mono" Text="{Binding EndpointText}" />
                                                                <Border Classes="pill">
                                                                    <TextBlock Text="{Binding TransportText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Classes="cell mono" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding HelloText, StringFormat='Hello {0}'}" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption" Margin="16,3,0,0" Text="{Binding OutcomeText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="h3" Text="传输统计" />
                                        <TextBlock Classes="caption" Text="{Binding StatisticsText}" />
                                        <ItemsControl ItemsSource="{Binding Routes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RouteStatRowViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Ellipse Classes="dot" Classes.success="{Binding IsSuccess}" Classes.warning="{Binding IsWarning}"
                                                                     Classes.danger="{Binding IsDanger}" />
                                                            <TextBlock Classes="cell mono" Text="{Binding EndpointText}" />
                                                            <TextBlock Classes="cell" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TransportText}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Classes="cell mono" Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding SentText}" /><Run Text=" 发 / " /><Run Text="{Binding LostText}" /><Run Text=" 丢 · " /><Run Text="{Binding LossText}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Classes="subtle" Padding="14,12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="h3" Text="经 Traversal 节点打洞" />
                                            <TextBlock Classes="caption" Text="请求 Traversal 节点同时引介双方并探测直连路径。双方都需已在同一 Traversal 节点登记，且本节点需有对应协议的监听端口。" />
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <ComboBox ItemsSource="{Binding TraversalCandidates}" SelectedItem="{Binding SelectedTraversal}" HorizontalAlignment="Stretch"
                                                          PlaceholderText="选择 Traversal 节点">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PeerItemViewModel">
                                                            <TextBlock Classes="mono" Text="{Binding Title}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="1" Width="86" ItemsSource="{Binding TransportOptions}" SelectedIndex="{Binding PunchTransportIndex}" />
                                                <Button Grid.Column="2" Command="{Binding PunchCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <c:LineIcon Data="{StaticResource Icon.Zap}" />
                                                        <TextBlock Text="打洞" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
